/target
**/target/
# Build directories that **/target/ misses because of their name.
**/*-target/
node_modules/
# Scoped to the extension's own Vite build output, not bare "dist/" — that
# would also match apps/extension/vendor/{sdk,ui}/dist, which are vendored
# package *source* (committed on purpose, see apps/extension/vendor/) and
# not build output of this repo at all.
apps/extension/dist/
apps/extension/dist-firefox/
apps/extension/web-ext-artifacts/
# wasm-bindgen output — regenerated by apps/extension/scripts/build-wasm.sh
apps/extension/src/wasm-gen/
# Playwright artifacts
playwright-report/
test-results/

# Private half of the keypair pinning the Chrome extension ID across
# reloads/machines (see apps/extension/public/manifest.json's "key" field)
# — whoever holds this can publish updates as this exact extension.
apps/extension/extension-key.pem

.DS_Store
*.swp
