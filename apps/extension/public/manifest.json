{
  "manifest_version": 3,
  "name": "OpenCapture \u2014 Private Full-Page Screenshot",
  "version": "0.1.0",
  "description": "100% local full-page screenshots. No cloud upload. All core features free; the watermark tool is a paid Supporter feature.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://accounts.openapps.network/*",
    "https://gateway.openapps.network/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accounts.openapps.network/v1/auth/oidc/google/callback*",
        "https://accounts.openapps.network/signin*",
        "https://accounts.openapps.network/link*"
      ],
      "js": [
        "openapps-callback.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "key": ""
}
